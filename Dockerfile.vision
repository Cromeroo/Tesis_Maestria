# vision-svc: solo necesita torch CPU + FastAPI (rappea LeafClassifier).
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEVICE=cpu TESIS_OFFLINE=1
WORKDIR /app
COPY requirements.txt requirements.docker.txt ./
RUN pip install --no-cache-dir -r requirements.docker.txt
COPY src/ ./src/
EXPOSE 8001
CMD ["uvicorn", "src.vision_svc.app:app", "--host", "0.0.0.0", "--port", "8001"]
