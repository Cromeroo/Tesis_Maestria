# Copia a .env y completa
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=us-central1
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=tizon_tardio
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CNN_WEIGHTS_PATH=./best_model_3class.pth
CNN_BACKBONE=simple_cnn
CONFIDENCE_LOW=0.60
CONFIDENCE_HIGH=0.90
DEVICE=auto  # auto | cuda | cpu (cuda = ROCm en AMD 9060 XT; en Docker siempre cpu)
CHECKPOINT_PATH=./checkpoints.db
API_KEY=  # vacío = sin auth; si se define, /diagnose exige X-API-Key
RATE_LIMIT_PER_MIN=30  # 0 = sin límite
LOG_LEVEL=INFO
# Observabilidad LangSmith (opcional, sin código extra):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
